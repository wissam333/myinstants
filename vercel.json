{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/detail$", "dest": "/api/detail.php" },
    { "src": "^/(101board|101categories|101category|101soundboards|best|category|favorites|memesoundboard|recent|search|search_all|trending|uploaded)$", "dest": "/api/list.php" },
    { "src": "^/(.*)$", "dest": "/api/404.php" }
  ]
}
